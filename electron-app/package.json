{
  "name": "nexus-electron-app",
  "version": "0.9.24",
  "releaseVersion": "0.9.24",
  "description": "Electron application for Nexus Terminal",
  "main": "main.js",
  "author": {
    "name": "caichengle666"
  },
  "homepage": "https://github.com/caichengle666/nexus-terminal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caichengle666/nexus-terminal.git"
  },
  "license": "GPL-3.0-only",
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.0",
    "iconv-lite": "^0.7.3",
    "node-pty": "^1.1.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "build:backend": "cd ../packages/backend && npm run build:prod",
    "build:frontend": "cd ../packages/frontend && npm run build",
    "build:electron": "electron-builder --win",
    "build": "npm run build:frontend && npm run build:backend && npm run build:electron"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.caichengle666.nexus-terminal",
    "productName": "Nexus Terminal",
    "buildVersion": "0.9.24.0",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW",
      "ja"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater-service.js",
      "update-network.js",
      "update-download-service.js",
      "update-verification.js",
      "update-public-key.js",
      "update-startup-check.js",
      "update-release-check.js",
      "backend-runtime.js",
      "security-utils.js",
      "window-state.js",
      "gpu-mode.js",
      "main-i18n.js",
      "package.json",
      "!node_modules/node-pty/{deps,src,scripts,third_party,typings}/**",
      "!node_modules/node-pty/binding.gyp",
      "!node_modules/node-pty/lib/**/*.{test.js,map}",
      "!node_modules/node-pty/build/**",
      "node_modules/node-pty/build/Release/*.{node,dll,exe}",
      "node_modules/node-pty/build/Release/spawn-helper",
      "node_modules/node-pty/build/Release/conpty/**",
      "!node_modules/node-pty/prebuilds/**",
      "node_modules/node-pty/prebuilds/${platform}-${arch}/**",
      "!node_modules/node-addon-api/**",
      "!node_modules/**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../packages/backend",
        "to": "packages/backend",
        "filter": [
          "dist/**",
          "html-presets/**",
          "!dist/**/*.map",
          "!dist/node_modules/typescript/**",
          "!dist/node_modules/node-gyp/**",
          "!dist/node_modules/@types/**",
          "!dist/node_modules/**/*.{d.ts,d.mts,d.cts}",
          "!dist/node_modules/**/{README,readme,Readme,CHANGELOG,changelog,Changelog,HISTORY,History,history}{,.md,.markdown,.txt}",
          "!dist/node_modules/*/{test,tests,__tests__,example,examples,docs}/**",
          "!dist/node_modules/@*/*/{test,tests,__tests__,example,examples,docs}/**",
          "!dist/node_modules/**/build/Release/{obj,obj.target,.deps}/**",
          "!dist/node_modules/**/build/{Debug,deps,obj.target,.deps}/**",
          "!dist/node_modules/**/build/*.{vcxproj,filters,sln,gypi,mk}",
          "!dist/node_modules/**/build/Makefile",
          "!dist/node_modules/**/*.{pdb,iobj,ipdb,ilk,obj,o,lib,exp,tlog,lastbuildstate,recipe}",
          "!dist/node_modules/sqlite3/{deps,src}/**",
          "!dist/node_modules/bcrypt/src/**",
          "!dist/node_modules/cpu-features/{deps,src}/**",
          "!dist/node_modules/bcrypt/prebuilds/**",
          "dist/node_modules/bcrypt/prebuilds/${platform}-${arch}/**",
          "!dist/node_modules/**/bare-*/prebuilds/**",
          "!dist/node_modules/ssh2/lib/protocol/crypto/{build,src}/**",
          "!dist/node_modules/cpu-features/**",
          "!dist/node_modules/jschardet/dist/**"
        ]
      },
      {
        "from": "../packages/frontend/dist",
        "to": "packages/frontend/dist"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-0.9.24-${name}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "bundleShortVersion": "0.9.24",
      "bundleVersion": "0.9.24.0",
      "artifactName": "${productName}-0.9.24-macOS-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName} Setup 0.9.24.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico"
    },
    "includePdb": false,
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    }
  }
}
