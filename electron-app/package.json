{
  "name": "nexus-electron-app",
  "version": "0.9.22.49",
  "releaseVersion": "0.9.22.49",
  "description": "Electron application for Nexus Terminal",
  "main": "main.js",
  "author": {
    "name": "caichengle666"
  },
  "homepage": "https://github.com/caichengle666/nexus-terminal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caichengle666/nexus-terminal.git"
  },
  "license": "GPL-3.0-only",
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.0",
    "iconv-lite": "^0.7.3",
    "node-pty": "^1.1.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "build:backend": "cd ../packages/backend && npm run build:prod",
    "build:frontend": "cd ../packages/frontend && npm run build",
    "prepare:node-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force -Path 'nodejs-runtime/win-x64' | Out-Null; Copy-Item -Path (Get-Command node).Source -Destination 'nodejs-runtime/win-x64/node.exe' -Force\"",
    "build:electron": "npm run prepare:node-runtime && electron-builder --win",
    "build": "npm run build:frontend && npm run build:backend && npm run build:electron"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.caichengle666.nexus-terminal",
    "productName": "Nexus Terminal",
    "buildVersion": "0.9.22.49",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater-service.js",
      "update-network.js",
      "update-download-service.js",
      "update-verification.js",
      "update-public-key.js",
      "update-startup-check.js",
      "security-utils.js",
      "window-state.js",
      "gpu-mode.js",
      "main-i18n.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../packages/backend",
        "to": "packages/backend",
        "filter": [
          "dist/**",
          "html-presets/**"
        ]
      },
      {
        "from": "../packages/frontend/dist",
        "to": "packages/frontend/dist"
      },
      {
        "from": "nodejs-runtime",
        "to": "nodejs-runtime"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-0.9.22.49-${name}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "bundleShortVersion": "0.9.22",
      "bundleVersion": "0.9.22.49",
      "artifactName": "${productName}-0.9.22.49-macOS-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName} Setup 0.9.22.49.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico"
    },
    "includePdb": false,
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    }
  }
}
