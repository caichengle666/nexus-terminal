# Nexus Terminal — example environment file.
#
# `.env` (tracked in git) holds the defaults that install.sh downloads on first install and then
# extends with generated secrets. This file documents every setting; copy what you need into `.env`.
# Never commit real secrets: install.sh writes ENCRYPTION_KEY / SESSION_SECRET / REMOTE_GATEWAY_SECRET
# into your local `.env` (mode 0600). Back that file up — losing ENCRYPTION_KEY makes saved
# connection credentials undecryptable.

# local/docker
DEPLOYMENT_MODE=docker

REMOTE_GATEWAY_API_BASE_LOCAL=http://localhost:9090
REMOTE_GATEWAY_API_BASE_DOCKER=http://remote-gateway:9090
REMOTE_GATEWAY_WS_URL_LOCAL=ws://localhost:8080
REMOTE_GATEWAY_WS_URL_DOCKER=ws://remote-gateway:8080

# passkey
RP_ID="yourdomain.com"
RP_ORIGIN="https://yourdomain.com"

# Image tag used by docker-compose (install.sh manages this)
# NEXUS_IMAGE_TAG=latest

# --- Secrets (generated by install.sh; for manual installs use `openssl rand -hex 32`) ---
# ENCRYPTION_KEY=
# SESSION_SECRET=
# Shared secret between backend and remote-gateway. Required for remote desktop (RDP/VNC) in Docker:
# without it the gateway only listens on 127.0.0.1 and refuses to expose its token API on other addresses.
# REMOTE_GATEWAY_SECRET=

# --- Security (optional, see README) ---
# SESSION_COOKIE_SECURE=true          # set when served over HTTPS
# ALLOWED_WS_ORIGINS=https://a.example.com,https://b.example.com
# TRUST_PROXY=2                       # only if another reverse proxy sits in front of the bundled nginx

# --- Remote desktop (optional) ---
# Token API listen address of the remote gateway. Empty = all interfaces when REMOTE_GATEWAY_SECRET
# is set, otherwise 127.0.0.1 only.
# REMOTE_GATEWAY_API_HOST=
# Seconds a remote desktop token stays valid (tokens are single-use).
# REMOTE_GATEWAY_TOKEN_TTL_SECONDS=60
# Ignore the RDP server's TLS certificate (default true: Windows uses a self-signed certificate by
# default). Set to false if your RDP hosts have certificates trusted by guacd.
# RDP_IGNORE_CERT=true
