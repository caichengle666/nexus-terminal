{
   "name": "@nexus-terminal/backend",
   "version": "0.1.0",
   "private": true,
   "main": "dist/index.js",
   "scripts": {
      "typecheck": "tsc --noEmit -p .",
      "test": "node --test test/*.test.js",
      "build": "tsc && copyfiles -u 1 \"src/locales/**/*.json\" dist/src",
      "test:transfers": "npm run build && node --test test/transfers.service.test.js",
      "prepare:dist": "node build-tools/prepare-dist.js",
      "build:prod": "npm run build && npm run prepare:dist && cd dist && npm install --omit=dev",
      "start": "node dist/index.js",
      "dev": "cross-env NODE_ENV=development npx ts-node-dev --respawn --transpile-only src/index.ts"
   },
   "dependencies": {
      "@simplewebauthn/server": "^14.0.3",
      "@types/archiver": "^8.0.0",
      "@types/multer": "^2.3.0",
      "@types/session-file-store": "^1.2.6",
      "@xterm/xterm": "^6.0.0",
      "adm-zip": "^0.6.1",
      "archiver": "^8.0.0",
      "archiver-zip-encrypted": "^2.0.0",
      "axios": "^1.20.0",
      "bcrypt": "^6.0.0",
      "brace-expansion": "^5.0.12",
      "date-fns": "^4.4.0",
      "date-fns-tz": "^3.2.0",
      "dotenv": "^18.0.8",
      "easyzip": "^1.0.3",
      "express": "^5.3.0",
      "express-rate-limit": "^8.7.1",
      "express-session": "^1.19.0",
      "helmet": "^8.3.0",
      "http-proxy-agent": "^9.1.0",
      "https-proxy-agent": "^9.1.0",
      "i18next": "^26.5.3",
      "i18next-fs-backend": "^2.6.9",
      "iconv-lite": "^0.7.3",
      "ipaddr.js": "^2.5.0",
      "jschardet": "^4.0.0",
      "multer": "^2.4.0",
      "nodemailer": "^10.1.7",
      "proxy-addr": "^2.0.8",
      "qrcode": "^1.5.4",
      "qs": "^6.16.1",
      "sanitize-filename": "^1.6.4",
      "sanitize-html": "^2.18.1",
      "session-file-store": "^1.5.0",
      "socks": "^2.8.10",
      "socks-proxy-agent": "^10.1.0",
      "speakeasy": "^2.0.0",
      "sqlite3": "^6.0.1",
      "ssh2": "^1.17.0",
      "uuid": "^14.0.3",
      "webdav": "^5.11.0",
      "ws": "^8.22.0"
   },
   "devDependencies": {
      "@types/bcrypt": "^6.0.0",
      "@types/cors": "^2.8.19",
      "@types/express": "^5.0.6",
      "@types/express-session": "^1.19.0",
      "@types/node": "^26.6.5",
      "@types/nodemailer": "^8.0.2",
      "@types/qrcode": "^1.5.6",
      "@types/speakeasy": "^2.0.10",
      "@types/ssh2": "^1.15.6",
      "@types/ws": "^8.18.2",
      "copyfiles": "^2.4.1",
      "cross-env": "^10.1.0",
      "esbuild": "^0.28.2",
      "ts-node-dev": "^2.0.0",
      "typescript": "5.9.3"
   }
}
